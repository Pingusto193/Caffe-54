// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurante {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String
  logo      String?

  // MVP: o site nao processa pedidos. Estas duas colunas ficam guardadas
  // (sem UI no painel) para reativar um botao de pedido no futuro sem migracao.
  linkPedido String?
  textoBotao String  @default("Pedir")

  // Contato exibido no site (rodape + secao "Visite")
  endereco  String?
  telefone  String?
  email     String?

  // Redes e links do rodape, na ordem em que o dono organizou. Formato:
  // [{ "tipo": "instagram", "valor": "caffe54", "rotulo": null }, ...]
  // "tipo" sai de TIPOS_LINK no server.js; "rotulo" so e usado com tipo "outro".
  links     Json?

  // Horario de funcionamento, estruturado por dia da semana. Formato:
  // [{ "dia": "seg", "abre": "08:00", "fecha": "18:00", "fechado": false }, ... 7 dias]
  horarios  Json?

  // Paragrafo "Sobre" da secao "Visite". Vazio = secao escondida.
  sobre     String?

  // Frase de abertura do cardapio (aparece acima dos filtros).
  // Vazio = so o rotulo "O cardapio" aparece.
  introCardapio String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins     Admin[]
  menuItems  MenuItem[]
  categorias Categoria[]
}

// Categorias do cardapio, gerenciadas pelo dono no painel (criar, renomear,
// reordenar, excluir). A ordem aqui define a ordem dos blocos no site.
model Categoria {
  id            Int         @id @default(autoincrement())
  nome          String
  ordem         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  itens         MenuItem[]

  @@unique([restauranteId, nome])
  @@index([restauranteId])
}

model MenuItem {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?
  preco         Float
  imagem        String?
  destaque      Boolean  @default(false)
  // item inativo nao aparece no site, mas continua no painel
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoriaId   Int
  categoria     Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
  @@index([categoriaId])
}

model Admin {
  id            Int     @id @default(autoincrement())
  usuario       String  @unique
  senhaHash     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restauranteId Int
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
}
