# Copie para .env e preencha. O .env não vai para o Git (está no .gitignore).
# Em produção estes mesmos nomes viram variáveis no Environment do Render.

# Postgres. Aqui: a base local `caffe-54`.
# No Render: a Internal Database URL do serviço de banco.
DATABASE_URL="postgresql://postgres:senha@localhost:5432/caffe-54"

# Segredo dos tokens do painel. Gere um longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem ele (ou com menos de 24 caracteres) o servidor nem sobe.
JWT_SECRET=""

# Login do painel. É daqui que o servidor confere usuário e senha — não existe
# usuário guardado no banco. Trocar a senha = trocar aqui e reiniciar o serviço.
ADMIN_USUARIO="admin.kf54"
ADMIN_SENHA=""

# Só em produção: pasta do disco persistente onde ficam as fotos enviadas pelo
# painel. Vazio/ausente = frontend/images/cardapio/, como no seu computador.
# PASTA_IMAGENS="/var/data/cardapio"
